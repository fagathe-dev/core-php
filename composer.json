{
  "name": "fagathe-dev/core-php",
  "description": "Librairie PHP Core et Sécurité",
  "type": "symfony-bundle",
  "autoload": {
    "psr-4": {
      "Fagathe\\CorePhp\\": "src/"
    },
    "files": [
      "files/functions.php",
      "files/constants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Fagathe\\CorePhp\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "symfony/mailer": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/form": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/security-http": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/finder": "^8.1",
    "doctrine/orm": "^3.6",
    "knplabs/knp-paginator-bundle": "^6.10",
    "fakerphp/faker": "^1.24",
    "mobiledetect/mobiledetectlib": "^4.8",
    "symfony/twig-bridge": "^8.1",
    "twig/twig": "^3.24",
    "symfony/http-kernel": "^7.4|^8.0",
    "symfony/dependency-injection": "^7.4|^8.0",
    "symfony/config": "^7.4|^8.0",
    "symfony/yaml": "^7.4|^8.0",
    "symfony/http-client": "^7.4|^8.0",
    "symfony/http-client-contracts": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  }
}
