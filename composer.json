{
  "name": "fagathe-dev/core-php",
  "description": "Librairie PHP Core et Sécurité",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Fagathe\\CorePhp\\": "src/"
    },
    "files": [
      "files/functions.php",
      "files/constants.php"
    ]
  },
  "require": {
    "php": ">=8.4",
    "symfony/mailer": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/form": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/security-http": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/finder": "^8.1",
    "doctrine/orm": "^3.6",
    "knplabs/knp-paginator-bundle": "^6.10",
    "fakerphp/faker": "^1.24",
    "mobiledetect/mobiledetectlib": "^4.8",
    "symfony/twig-bridge": "^8.1",
    "twig/twig": "^3.24"
