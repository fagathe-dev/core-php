{#
  Carte du DS dans le corps de l'e-mail : surface blanche, contour discret, rayon de base.
  Props : content (HTML), background, padding (défaut 24px, --ds-space-6), spacing, custom_style.
#}
{% set t = email_theme %}
{% set background = background|default(t.surface) %}
{% set padding = padding|default('24px') %}
{% set content = content|default('') %}
{% set spacing = spacing|default('16px') %}
{% set custom_style = custom_style|default('') %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 0 0 {{ spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding: {{ padding }}; background-color: {{ background }}; border: 1px solid {{ t.border }}; border-radius: {{ t.radius }}; font-family: {{ t.font_sans }}; font-size: 16px; line-height: 1.5; color: {{ t.text }}; {{ custom_style }}">
            {{ content|raw }}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
