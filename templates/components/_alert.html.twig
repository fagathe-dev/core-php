{#
  Alerte du DS (.alert-soft-{role} / .alert-solid-{role}) : fond du rôle, sans bordure.
  Props : type (info, success, warning, danger, primary, secondary, tertiary), variant (soft, solid),
          title, content (HTML), spacing, custom_style.
#}
{% set t = email_theme %}
{% set type = t.roles[type|default('info')] is defined ? type|default('info') : 'info' %}
{% set variant = variant|default('soft') %}
{% set title = title|default(null) %}
{% set content = content|default('') %}
{% set spacing = spacing|default('16px') %}
{% set custom_style = custom_style|default('') %}
{% set r = t.roles[type] %}
{% set bg = variant == 'solid' ? r.base : r.container %}
{% set color = variant == 'solid' ? r.on : r.on_container %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 0 0 {{ spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding: 12px 16px; background-color: {{ bg }}; border-radius: {{ t.radius }}; color: {{ color }}; font-family: {{ t.font_sans }}; font-size: 14px; line-height: 1.5; {{ custom_style }}">
            {% if title %}
            <p style="margin: 0 0 4px; font-weight: 600; color: {{ color }};">{{ title }}</p>
            {% endif %}
            <div style="color: {{ color }};">{{ content|raw }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
