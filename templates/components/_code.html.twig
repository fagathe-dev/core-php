{#
  Code à usage unique (connexion, vérification, suppression de compte) : grand, espacé, en police mono.
  Props : code, label (texte au-dessus, optionnel), role (optionnel : fond du rôle, ex. danger), spacing (en px, défaut 16).
#}
{% set t = email_theme %}
{% set r = role is defined and t.roles[role] is defined ? t.roles[role] : null %}
{% set code = code|default('') %}
{% set label = label|default(null) %}
{% set spacing = spacing|default(16) %}
{% set background = r ? r.container : t.surface_low %}
{% set border = r ? r.container : t.border %}
{% set color = r ? r.on_container : t.text %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 8px 0 {{ spacing + 8 }}px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td align="center" style="padding: 24px 16px; background-color: {{ background }}; border: 1px solid {{ border }}; border-radius: {{ t.radius }};">
            {% if label %}
            <p style="margin: 0 0 8px; font-family: {{ t.font_sans }}; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: {{ r ? r.on_container : t.text_muted }};">{{ label }}</p>
            {% endif %}
            <p style="margin: 0; font-family: {{ t.font_mono }}; font-size: 32px; font-weight: 700; line-height: 1.2; letter-spacing: 8px; color: {{ color }};">{{ code }}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
