{#
  Encart sur une surface tonale (containment du DS) : bloc mis en avant dans la carte.
  Props : content (HTML), role (optionnel : fond et contour du rôle, ex. danger), background, padding, radius,
          bordered (contour outline-variant, défaut true), spacing, custom_style.
#}
{% set t = email_theme %}
{% set r = role is defined and t.roles[role] is defined ? t.roles[role] : null %}
{% set background = background|default(r ? r.container : t.surface_low) %}
{% set padding = padding|default('16px') %}
{% set radius = radius|default(t.radius) %}
{% set bordered = bordered ?? true %}
{% set border = bordered ? '1px solid ' ~ (r ? r.container : t.border) : 'none' %}
{% set content = content|default('') %}
{% set spacing = spacing|default('16px') %}
{% set custom_style = custom_style|default('') %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 0 0 {{ spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding: {{ padding }}; background-color: {{ background }}; border: {{ border }}; border-radius: {{ radius }}; font-family: {{ t.font_sans }}; font-size: 16px; line-height: 1.5; color: {{ t.text }}; {{ custom_style }}">
            {{ content|raw }}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
