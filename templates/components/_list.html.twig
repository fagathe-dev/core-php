{#
  Liste à puces (body-lg), puces dans la couleur primary du DS.
  Props : items (tableau de HTML), bullet_color, spacing, custom_style.
#}
{% set t = email_theme %}
{% set items = items|default([]) %}
{% set bullet_color = bullet_color|default(t.roles.primary.base) %}
{% set spacing = spacing|default('16px') %}
{% set custom_style = custom_style|default('') %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 0 0 {{ spacing }};">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="{{ custom_style }}">
        {% for item in items %}
        <tr>
          <td width="20" valign="top" style="padding: 4px 0; color: {{ bullet_color }}; font-family: {{ t.font_sans }}; font-size: 16px; line-height: 1.5;">&#8226;</td>
          <td valign="top" style="padding: 4px 0; color: {{ t.text }}; font-family: {{ t.font_sans }}; font-size: 16px; line-height: 1.5;">{{ item|raw }}</td>
        </tr>
        {% endfor %}
      </table>
    </td>
  </tr>
</table>
